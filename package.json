{
  "name": "kumanga",
  "version": "0.1.0",
  "private": true,
  "description": "Kumanga \u2014 a local-first, bring-your-own-key manga creation harness.",
  "workspaces": [
    "manga-studio"
  ],
  "scripts": {
    "dev": "next dev manga-studio --turbopack",
    "build": "next build manga-studio --turbopack",
    "start": "next start manga-studio",
    "test": "npm --prefix manga-studio run test",
    "typecheck": "npm --prefix manga-studio run typecheck",
    "lint": "npm --prefix manga-studio run lint"
  }
}
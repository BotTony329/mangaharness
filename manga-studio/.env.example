# ─── Image generation provider ──────────────────────────────────────────────
# Which adapter to use: "gemini" | "generic-rest"
IMAGE_PROVIDER=gemini

# Gemini adapter ("nano banana" image models). Only the key is required;
# base URL and model have sensible defaults.
GEMINI_API_KEY=
# IMAGE_MODEL=gemini-2.5-flash-image
# IMAGE_API_BASE_URL=https://generativelanguage.googleapis.com

# Generic OpenAI-compatible images adapter (used when IMAGE_PROVIDER=generic-rest)
# IMAGE_API_BASE_URL=https://api.example.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=

# ─── Manga Agent LLM provider (separate from the image provider) ────────────
# Any OpenAI-compatible chat-completions endpoint. Defaults target DeepSeek.
AGENT_API_KEY=
# AGENT_API_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-chat

# ─── Persistent object storage for generated/uploaded images ────────────────
# On Vercel: create a Blob store and this token is injected automatically.
# Locally without a token, files fall back to ./.data (dev only).
BLOB_READ_WRITE_TOKEN=

# Set to "1" to allow private-network provider URLs in local development only.
# Never set this in production.
# ALLOW_PRIVATE_NETWORKS=

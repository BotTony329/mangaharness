# ─── Required deployment secret ─────────────────────────────────────────────
# Encrypts user-provided AI provider credentials (BYOK) into HttpOnly session
# cookies. It does NOT contain any AI API key itself. Generate a long random
# string, e.g.: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ─── Persistent object storage for generated/uploaded images ────────────────
# On Vercel: create a Blob store and this token is injected automatically.
# Locally without a token, files fall back to ./.data (dev only).
BLOB_READ_WRITE_TOKEN=

# ─── Optional deployment-default providers ──────────────────────────────────
# Users normally connect their own providers in-app via AI Settings (BYOK).
# These env vars are an OPTIONAL operator fallback used only when a user has
# no session configuration of their own. User BYOK settings always win.

# Image generation fallback: "gemini" | "sdnext" | "generic-rest"
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=
# IMAGE_MODEL=gemini-2.5-flash-image
# IMAGE_API_BASE_URL=
# IMAGE_API_KEY=
#
# For SD.Next local fallback:
# IMAGE_PROVIDER=sdnext
# SDNEXT_BASE_URL=http://127.0.0.1:7860
# SDNEXT_API_KEY=   # optional username:password if launched with --auth
# SDNEXT_MODEL=

# Background-removal fallback (users can instead configure this in AI Settings)
# BACKGROUND_REMOVAL_PROVIDER=remove-bg  # "remove-bg" | "sdnext"
# BACKGROUND_REMOVAL_API_KEY=
# BACKGROUND_REMOVAL_API_BASE_URL=https://api.remove.bg/v1.0/removebg
# BACKGROUND_REMOVAL_MODEL=background-removal

# Manga Agent LLM fallback (OpenAI-compatible; defaults target DeepSeek)
# AGENT_API_KEY=
# AGENT_API_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-chat

# ─── Development only ───────────────────────────────────────────────────────
# Set to "1" to allow private-network provider URLs (localhost model servers
# like Ollama/LM Studio) in local development. Never set in production —
# hosted serverless can't reach your localhost anyway, and allowing private
# ranges there would open SSRF.
# ALLOW_PRIVATE_NETWORKS=1
